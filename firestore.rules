rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esAdmin() {
      return authed() && perfil().esAdmin == true;
    }
    function esSecretaria() {
      return authed() && perfil().esSecretaria == true;
    }
    function esStaff() {
      return esAdmin() || esSecretaria();
    }
    // [NEW BODEGA v3] Personal de la bodega nueva (Persona 1/2/3/4)
    function esPersonalBodega() {
      return authed() && perfil().get('esBodega', false) == true
        && perfil().get('activoBodega', true) == true;
    }
    function tieneRolBodega(rol) {
      return esPersonalBodega() && rol in perfil().get('rolesBodega', []);
    }
    // [REFUERZO] Validaciones de los datos nuevos (precios de Recepción y Producción → P. terminado)
    function numNoNeg(v) {
      return (v is int || v is float) && v >= 0;
    }
    function precioValido(d) {
      return !('valorTotal' in d) || numNoNeg(d.valorTotal);
    }
    function envioPTNuevoValido(d) {
      return d.get('envioPT', {}).get('estado', '') == 'PENDIENTE'
        && d.envioPT.keys().hasOnly(['estado'])
        && d.get('consumo', null) is list
        && d.consumo.size() <= 80
        && (d.get('totalUnidades', 0) is int) && d.totalUnidades > 0;
    }
    function confirmPTValida(nuevo, viejo) {
      let e = nuevo.envioPT;
      return e.keys().hasOnly(['estado', 'recibido', 'danado', 'faltante', 'totalRecibido', 'totalDanado', 'totalFaltante',
                               'nota', 'fechaConfirmacion', 'confirmadoPor', 'confirmadoPorNombre', 'confirmadoEn', 'confirmadoLocal'])
        && e.keys().hasAll(['estado', 'recibido', 'totalRecibido', 'totalDanado', 'totalFaltante', 'confirmadoPor', 'confirmadoEn'])
        && e.recibido is map
        && e.get('danado', {}) is map
        && e.get('faltante', {}) is map
        && e.totalRecibido is int && e.totalRecibido >= 0
        && e.totalDanado is int && e.totalDanado >= 0
        && e.totalFaltante is int && e.totalFaltante >= 0
        // Recibido + dañado + faltante = exactamente lo que envió Producción
        && e.totalRecibido + e.totalDanado + e.totalFaltante == viejo.totalUnidades
        // "Recibido completo" solo si no hubo dañado ni faltante; si hubo, debe ser "con diferencia"
        && (e.estado == 'CONFIRMADA') == (e.totalDanado + e.totalFaltante == 0)
        && e.confirmadoPor == request.auth.uid
        && e.confirmadoEn == request.time;
    }
    function mismaRutaRecurso() {
      return resource.data.empleado == perfil().ruta;
    }
    function mismaRutaNuevo() {
      return request.resource.data.empleado == perfil().ruta;
    }
    match /usuarios/{userId} {
      allow read: if authed() && request.auth.uid == userId;
      allow read: if esSecretaria();
      // [NEW BODEGA v3] Persona 4 necesita la lista de asesores/rutas para la carga al camión
      allow read: if esPersonalBodega();
      allow read, write: if esAdmin();
    }
    match /pedidos/{id} {
      allow create: if esAdmin() || (authed() && mismaRutaNuevo());
      allow read: if esStaff() || (authed() && mismaRutaRecurso());
      allow update, delete: if esStaff();
      // El asesor solo puede marcar UNA vez que imprimió el ticket de SUS pedidos (solo "true", hora del servidor). Cualquier otro cambio se rechaza.
      allow update: if authed() && mismaRutaRecurso()
        && !('ticketImpreso' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketImpreso', 'ticketImpresoEn'])
        && request.resource.data.ticketImpreso == true
        && request.resource.data.ticketImpresoEn == request.time;
    }
    match /pagos/{id} {
      allow create: if esAdmin() || (authed() && mismaRutaNuevo());
      allow read: if esStaff() || (authed() && mismaRutaRecurso());
      allow update, delete: if esStaff();
    }
    match /gastos/{id} {
      allow create: if esAdmin() || (authed() && mismaRutaNuevo());
      allow read: if esStaff() || (authed() && mismaRutaRecurso());
      allow update, delete: if esStaff();
    }
    match /productos/{id} {
      allow read: if authed();
      allow write: if esAdmin();
    }
    match /historialCambios/{id} {
      allow create: if esStaff();
      allow read: if esAdmin();
    }
    match /pedidosEliminados/{id} {
      allow create: if esStaff();
      allow read: if esAdmin();
      // [NEW] Editar cliente: el admin puede corregir datos en los respaldos de eliminados (ej. nombre del cliente)
      allow update: if esAdmin();
    }
    match /inventarioMovimientos/{id} {
      allow create: if esAdmin() || (authed() && request.resource.data.usuario == perfil().ruta)
        // [NEW BODEGA v3] La bodega solo puede escribir movimientos marcados como suyos (origen bodega_*)
        || (esPersonalBodega() && request.resource.data.origen is string && request.resource.data.origen.matches('bodega_.*'));
      allow read, delete: if esAdmin();
    }
    match /rolesPago/{id} {
      allow read, create: if esAdmin();
    }
    match /cierresLiquidacion/{id} {
      allow read, write: if esStaff();
    }
    match /cierresDelDia/{id} {
      allow read, write: if esStaff();
    }
    // Lista de precios oficial por cliente (se carga desde Importar Datos del dashboard)
    match /preciosClientes/{id} {
      allow read: if esStaff() || (authed() && mismaRutaRecurso());
      allow write: if esStaff();
    }
    // [NEW] Asesor principal por cliente (Consultar por Cliente → Editar cliente).
    // Admin y secretaria leen (Consultar por Cliente / Cobranzas por Asesor); solo el admin cambia.
    match /asesorPrincipalClientes/{id} {
      allow read: if esStaff();
      allow write: if esAdmin();
    }

    // ── Bodega ANTERIOR (ya no la usa la app nueva; se pueden borrar cuando ya no se necesite su historial) ──
    match /controlesBodega/{id} {
      allow read, create, update: if esAdmin() || esStaff();
      allow delete: if esAdmin();
    }
    match /productosControl/{id} {
      allow read: if authed();
      allow write: if esAdmin();
    }
    match /alertasBodega/{id} {
      allow read, create: if esAdmin() || esStaff();
      allow update, delete: if esAdmin();
    }
    match /auditoriaBodega/{id} {
      allow create: if authed();
      allow read: if esAdmin() || esStaff();
    }

    // ══════════ [NEW BODEGA v3] ══════════
    // Catálogo de insumos (BULTOS / TAPAS / ETIQUETAS)
    match /bodInsumos/{id} {
      allow read: if esStaff() || esPersonalBodega();
      allow write: if esAdmin();
    }
    // [PRODUCCIÓN→PT] Recetas: materia prima que se gasta por 1 unidad de cada producto terminado
    match /bodRecetas/{id} {
      allow read: if esStaff() || esPersonalBodega();
      allow write: if esAdmin();
    }
    // Libro de movimientos de bodega. Nadie borra; solo el admin anula (update).
    // Cada persona solo puede registrar SU etapa. Daños: cualquiera de la bodega.
    // Devolución del camión: quien tiene la etapa CARGA. Ajuste: solo admin.
    match /bodMovimientos/{id} {
      allow read: if esStaff() || esPersonalBodega();
      allow create: if request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.anulado == false
        && request.resource.data.fecha is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 80
        && (
          esAdmin()
          || (request.resource.data.etapa in ['RECEPCION', 'PRODUCCION', 'TERMINADO', 'CARGA']
              && tieneRolBodega(request.resource.data.etapa))
          || (request.resource.data.etapa == 'DEVOLUCION' && tieneRolBodega('CARGA'))
          || (request.resource.data.etapa == 'RETORNO_ENVASE' && tieneRolBodega('CARGA'))
          || (request.resource.data.etapa == 'DANO' && esPersonalBodega())
          // [ENTREGA] Recepción también puede ENVIAR insumos a producción
          || (request.resource.data.etapa == 'PRODUCCION' && tieneRolBodega('RECEPCION')
              && request.resource.data.get('entrega', {}).get('origen', '') == 'RECEPCION')
          // [PRODUCCIÓN→PT] Producción envía producto terminado (lo confirma P. terminado)
          || (request.resource.data.etapa == 'PRODUCIDO' && tieneRolBodega('PRODUCCION'))
        )
        // [PRODUCCIÓN→PT] El envío a P. terminado siempre nace PENDIENTE; ya nadie registra TERMINADO a mano (salvo admin)
        && (request.resource.data.etapa != 'PRODUCIDO' || envioPTNuevoValido(request.resource.data))
        // [REFUERZO] Solo los envíos de Producción pueden traer envioPT/consumo
        && (request.resource.data.etapa == 'PRODUCIDO'
            || (!('envioPT' in request.resource.data) && !('consumo' in request.resource.data)))
        // [REFUERZO] Total de la factura (Recepción), si viene, es un número no negativo
        && precioValido(request.resource.data)
        && (request.resource.data.etapa != 'TERMINADO' || esAdmin())
        // [ENTREGA] Una entrega nueva siempre nace PENDIENTE (nadie la crea ya confirmada)
        && (!('entrega' in request.resource.data)
            || request.resource.data.entrega.estado in ['PENDIENTE_PRODUCCION', 'PENDIENTE_RECEPCION']);
      allow update: if esAdmin();
      // [ENTREGA] Confirmaciones Recepción <-> Producción: solo el campo "entrega",
      // y cada uno solo cuando le toca (Producción confirma lo recibido;
      // Recepción confirma la salida, revisa dañados/faltantes o cancela su envío).
      allow update: if resource.data.anulado == false
        && resource.data.etapa == 'PRODUCCION'
        && resource.data.get('entrega', null) != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entrega'])
        && request.resource.data.entrega.origen == resource.data.entrega.origen
        && (
          (resource.data.entrega.estado == 'PENDIENTE_PRODUCCION' && tieneRolBodega('PRODUCCION'))
          // Recepción puede CANCELAR su envío solo mientras Producción no lo haya confirmado
          || (resource.data.entrega.estado == 'PENDIENTE_PRODUCCION' && tieneRolBodega('RECEPCION')
              && request.resource.data.entrega.estado == 'CANCELADA')
          || (resource.data.entrega.estado in ['PENDIENTE_RECEPCION', 'PENDIENTE_DEVOLUCION'] && tieneRolBodega('RECEPCION'))
        );
      // [PRODUCCIÓN→PT] P. terminado confirma una sola vez lo que envió Producción: solo el campo "envioPT"
      allow update: if resource.data.anulado == false
        && resource.data.etapa == 'PRODUCIDO'
        && resource.data.get('envioPT', {}).get('estado', '') == 'PENDIENTE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['envioPT'])
        && request.resource.data.envioPT.estado in ['CONFIRMADA', 'CON_DIFERENCIA']
        && confirmPTValida(request.resource.data, resource.data)
        && tieneRolBodega('TERMINADO');
    }

    // ══════════ [NEW] ENVASES EN PRÉSTAMO (app de pedidos) ══════════
    // El asesor registra lo que PRESTÓ o le DEVOLVIERON, solo de SU ruta.
    // Admin y secretaria leen todo (dashboard y cuadre del camión). Nadie borra.
    match /envasesPrestamos/{id} {
      allow create: if esAdmin()
        || (authed() && mismaRutaNuevo()
            && request.resource.data.creadoPor == request.auth.uid
            && request.resource.data.tipo in ['PRESTAMO', 'DEVOLUCION']
            && request.resource.data.cantidad is int
            && request.resource.data.cantidad > 0
            && request.resource.data.anulado == false);
      allow read: if esStaff() || (authed() && mismaRutaRecurso());
      allow update: if esStaff();
    }

    // ══════════ [NEW 27-oct] AVISOS DE CAMBIO (Consultar por Cliente) ══════════
    // Cuando admin o secretaria EDITAN o ELIMINAN un pedido/pago se deja un aviso mínimo
    // para que el dashboard relea solo ese registro (memoria en el navegador).
    // Nadie lo edita; solo el admin borra (limpieza automática de avisos de +30 días).
    match /cambiosRegistros/{id} {
      allow create: if esStaff()
        && request.resource.data.keys().hasOnly(['coleccion', 'ids', 'accion', 'por', 'creadoEn'])
        && request.resource.data.coleccion in ['pedidos', 'pagos']
        && request.resource.data.ids is list
        && request.resource.data.ids.size() > 0
        && request.resource.data.ids.size() <= 400
        && request.resource.data.creadoEn == request.time;
      allow read: if esStaff();
      allow delete: if esAdmin();
    }
  }
}
